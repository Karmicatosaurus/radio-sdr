// fenetre.blp - Karmicatosaurus - 2026

using Gtk 4.0;
using Adw 1;

template $FenetreRadio : Adw.ApplicationWindow {
  title: _("Radio SDR");
  default-width: 460;
  default-height: 760;
  resizable: false;
  close-request => $_sur_fermeture();
  
  content: Adw.ToastOverlay notifications {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.ViewSwitcher {
          stack: onglets;
          policy: wide;
        };
      }
      
      content: Adw.ViewStack onglets {
        Adw.ViewStackPage {
          name: "radio";
          title: _("Radio");
          icon-name: "audio-speakers-symbolic";
          
          child: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Box {
                orientation: vertical;
                spacing: 12;
                
                styles ["bandeau"]
                
                Label etiquette_freq {
                  styles ["title-1","affichage-frequence"]
                }
                
                Label etiquette_etat {
                  styles ["dim-label"]
                }
                
                LevelBar vumetre {
                  min-value: 0;
                  max-value: 1;
                  
                  styles ["vumetre"]
                }
                
                Button bouton_lecture {
                  halign: center;
                  clicked => $_sur_clic_lecture();
                  styles ["pill"]
                  
                  child: Adw.ButtonContent contenu_lecture {};
                }
              }
            }
            
            Adw.PreferencesGroup {
              title: _("Réception");
              
              Adw.SpinRow ligne_freq {
                title: _("Fréquence");
                subtitle: _("Mhz");
                digits: 4;
                numeric: true;
                adjustment: Gtk.Adjustment {
                  lower: 24;
                  upper: 1766;
                  step-increment: 0.1;
                  page-increment: 1;
                };
                notify::value => $_sur_frequence_modifie();
              }
              
              Adw.ComboRow ligne_mode{
                title: _("Modulation");
                notify::selected => $_sur_reglage_modifie();
              }
              
              Adw.SwitchRow ligne_gain_auto {
                title: _("Gain automatique");
                notify::value => $_sur_reglage_modifie();
              }
              
              
              Adw.SpinRow ligne_gain {
                title: _("Gain");
                subtitle: _("dB");
                digits: 1;
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 49.6;
                  step-increment: 0.5;
                  page-increment: 5;
                };
                sensitive: bind ligne_gain_auto.active inverted;
                notify::value => $_sur_reglage_modifie();
              }
              
              Adw.SpinRow ligne_squelch {
                title: _("Squelch");
                subtitle: _("0 = désactivé (non utilisé en FM large");
                numeric: true;
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 1000;
                  step-increment: 10;
                  page-increment: 100;
                };
                notify::value => $_sur_reglage_modifie();
              }
              
              Adw.SpinRow ligne_ppm {
                title: _("Correction PPM");
                subtitle: _("Compensation de l'écart de fréquence");
                numeric: true;
                adjustment: Gtk.Adjustment {
                  lower: -200;
                  upper: 200;
                  step-increment: 1;
                  page-increment: 10;
                };                
                notify::value => $_sur_reglage_modifie();
              }
            }
            
            Adw.PreferencesGroup {
              title: _("Audio");
              
              Adw.ActionRow {
                title: _("Volume");
                
                [suffix]
                Scale curseur_volume {
                  orientation: horizontal;
                  hexpand: true;
                  valign: center;
                  digits: 2;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 2;
                    step-increment: 0.05;
                    page-increment: 0.5;
                  };
                  value-changed => $_sur_volume();
                }
              }
            }
          };
        }
        
        Adw.ViewStackPage {
          name: "favoris";
          title: _("Favoris");
          icon-name: "starred-symbolic";
          
          child: Adw.PreferencesPage {
            Adw.PreferencesGroup groupe_favoris {
              title: _("Favoris");
              
              header-suffix: Button {
                icon-name: "list-add-symbolic";
                tooltip-text: _("Ajouter la fréquence actuelle");
                valign: center;
                clicked => $_sur_ajout_favori();
                
                styles ["flat"]
              };
            }
          };
        }
      };
    };
  };
}
