<?xml version="1.0" encoding="utf-8"?>
<interface>
    <requires lib="gtk" version="4.0" />
    <requires lib="libadwaita" version="1.4" />

    <object class="GtkAdjustment" id="reglage_frequence">
        <property name="lower">24</property>
        <property name="upper">1766</property>
        <property name="step-increment">0.1</property>
        <property name="page-increment">1</property>
    </object>

    <object class="GtkAdjustment" id="reglage_gain">
        <property name="lower">0</property>
        <property name="upper">49.6</property>
        <property name="step-increment">0.5</property>
        <property name="page-increment">5</property>
    </object>

    <object class="GtkAdjustment" id="reglage_squelch">
        <property name="lower">0</property>
        <property name="upper">1000</property>
        <property name="step-increment">10</property>
        <property name="page-increment">100</property>
    </object>    

    <object class="GtkAdjustment" id="reglage_ppm">
        <property name="lower">-200</property>
        <property name="upper">200</property>
        <property name="step-increment">1</property>
        <property name="page-increment">10</property>
    </object>    

    <object class="GtkAdjustment" id="reglage_volume">
        <property name="lower">0</property>
        <property name="upper">2</property>
        <property name="step-increment">0.05</property>
        <property name="page-increment">0.5</property>
    </object>    

    <template class="FenetreRadio" parent="AdwApplicationWindow">
        <property name="title">Radio SDR</property>
        <property name="default-width">460</property>
        <property name="default-height">760</property>
        <signal name="close-request" handler="_sur_fermeture" />
        <property name="content">
            <object class="AdwToastOverlay" id="notifications">
                <property name="child">
                    <object class="AdwToolbarView">
                        <child type="top">
                            <object class="AdwHeaderBar">
                                <property name="title-widget">
                                    <object class="AdwViewSwitcher">
                                        <property name="stack">onglets</property>
                                        <property name="policy">wide</property>
                                    </object>
                                </property>
                            </object>
                        </child>

                        <property name="content">
                            <object class="AdwViewStack" id="onglets">
                            <!-- Onglet radio -->
                                <child>
                                    <object class="AdwViewStackPage">
                                        <property name="name">radio</property>
                                        <property name="title">Radio</property>
                                        <property name="icon-name">audio-speakers-symbolic</property>
                                        <property name="child">
                                            <object class="AdwPreferencesPage">
                                            <child>
                                                <object class="AdwPreferencesGroup">
                                                    <child>
                                                        <object class="GtkBox">
                                                            <property name="orientation">vertical</property>
                                                            <property name="spacing">12</property>
                                                            <style>
                                                                <class name="bandeau" />
                                                            </style>
                                                            <child>
                                                                <object class="GtkLabel" id="etiquette_freq">
                                                                    <style>
                                                                        <class name="title-1" />
                                                                        <class name="affichage-frequence" />
                                                                    </style>
                                                                </object>
                                                            </child>
                                                            <child>
                                                                <object class="GtkLabel" id="etiquette_etat">
                                                                    <style>
                                                                        <class name="dim-label" />
                                                                    </style>
                                                                </object>
                                                            </child>
                                                            <child>
                                                                <object class="GtkLevelBar" id="vumetre">
                                                                    <property name="min-value">0</property>
                                                                    <property name="max-value">1</property>
                                                                    <style>
                                                                        <class name="vumetre" />
                                                                    </style>
                                                                </object>
                                                            </child>
                                                            <child>
                                                                <object class="GtkButton" id="bouton_lecture">
                                                                    <property name="halign">center</property>
                                                                    <signal name="clicked" handler="_sur_clic_lecture" />
                                                                    <style>
                                                                        <class name="pill" />
                                                                    </style>
                                                                    <property name="child">
                                                                        <object class="AdwButtonContent" id="contenu_lecture" />
                                                                    </property>
                                                                </object>
                                                            </child>
                                                        </object>
                                                    </child>
                                                </object>
                                            </child>
                                            <!-- Réception -->
                                            <child>
                                                <object class="AdwPreferencesGroup">
                                                    <property name="title">Réception</property>
                                                    <child>
                                                        <object class="AdwSpinRow" id="ligne_freq">
                                                            <property name="title">Fréquence</property>
                                                            <property name="subtitle">Mhz</property>
                                                            <property name="digits">4</property>
                                                            <property name="numeric">true</property>
                                                            <property name="adjustment">reglage_frequence</property>
                                                            <signal name="notify::value" handler="_sur_frequence_modifie" />
                                                        </object>
                                                    </child>
                                                    <child>
                                                        <object class="AdwComboRow" id="ligne_mode">
                                                            <property name="title">Modulation</property>
                                                            <signal name="notify::selected" handler="_sur_reglage_modifie" /> 
                                                        </object>
                                                    </child>
                                                    <child>
                                                        <object class="AdwSwitchRow" id="ligne_gain_auto">
                                                            <property name="title">Gain automatique</property>
                                                            <signal name="notify::active" handler="_sur_reglage_modifie" />
                                                        </object>
                                                    </child>
                                                    <child>
                                                        <object class="AdwSpinRow" id="ligne_gain">
                                                            <property name="title">Gain</property>
                                                            <property name="subtitle">dB</property>
                                                            <property name="digits">1</property>
                                                            <property name="adjustment">reglage_gain</property>
                                                            <!-- Grisé quand le gain automatique est actif -->
                                                            <property name="sensitive" bind-source="ligne_gain_auto" bind-property="active" bind-flags="sync-create|invert-boolean" />
                                                            <signal name="notify::value" handler="_sur_reglage_modifie" />
                                                        </object>
                                                    </child>
                                                    <child>
                                                        <object class="AdwSpinRow" id="ligne_squelch">
                                                            <property name="title">Squelch</property>
                                                            <property name="subtitle">0 = désactivé (non utilisé en FM large)</property>
                                                            <property name="numeric">true</property>
                                                            <property name="adjustment">reglage_squelch</property>
                                                            <signal name="notify::value" handler="_sur_reglage_modifie" />
                                                        </object>
                                                    </child>
                                                    <child>
                                                        <object class="AdwSpinRow" id="ligne_ppm">
                                                            <property name="title">Correction PPM</property>
                                                            <property name="subtitle">Décalage de l'oscillateur</property>
                                                            <property name="numeric">true</property>
                                                            <property name="adjustment">reglage_ppm</property>
                                                            <signal name="notify::value" handler="_sur_reglage_modifie" />
                                                        </object>
                                                    </child>
                                                </object>
                                            </child>
                                            <!-- Audio -->
                                            <child>
                                                <object class="AdwPreferencesGroup">
                                                    <property name="title">Audio</property>
                                                    <child>
                                                        <object class="AdwActionRow">
                                                            <property name="title">Volume</property>
                                                            <child type="suffix">
                                                                <object class="GtkScale" id="curseur_volume">
                                                                    <property name="orientation">horizontal</property>
                                                                    <property name="hexpand">true</property>
                                                                    <property name="valign">center</property>
                                                                    <property name="digits">2</property>
                                                                    <property name="adjustment">reglage_volume</property>
                                                                    <signal name="value-changed" handler="_sur_volume" />
                                                                </object>
                                                            </child>
                                                        </object>
                                                    </child>
                                                </object>
                                            </child>
                                            </object>
                                        </property>
                                    </object>
                                </child>
                                <!-- Onglet favoris -->
                                <child>
                                    <object class="AdwViewStackPage">
                                        <property name="name">favoris</property>
                                        <property name="title">Favoris</property>
                                        <property name="icon-name">starred-symbolic</property>
                                        <property name="child">
                                            <object class="AdwPreferencesPage">
                                                <child>
                                                    <object class="AdwPreferencesGroup" id="groupe_favoris">
                                                        <property name="title">Favoris</property>
                                                        <property name="header-suffix">
                                                            <object class="GtkButton">
                                                                <property name="icon-name">list-add-symbolic</property>
                                                                <property name="tooltip-text">Ajouter la fréquence actuelle</property>
                                                                <property name="valign">center</property>
                                                                <signal name="clicked" handler="_sur_ajout_favori" />
                                                                <style>
                                                                    <class name="flat" />
                                                                </style>
                                                            </object>
                                                        </property>
                                                    </object>
                                                </child>
                                            </object>
                                        </property>
                                    </object>
                                </child>

                            </object>
                        </property>

                    </object>
                </property>
            </object>
        </property>
    </template>
</interface>